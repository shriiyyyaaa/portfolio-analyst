# Copy this file to .env and fill in real values.

# Get a free/paid key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Model to use via OpenRouter. This one auto-routes to a free model that
# supports tool calling, so Step 3 costs nothing to test. Swap to a paid
# model any time (e.g. a Claude or GPT model slug from openrouter.ai/models)
# once you add credits - no code changes needed, just this line.
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# SQLite for local dev. No setup needed - it's just a file.
DATABASE_URL=sqlite:///./portfolio.db

# Password gating the business admin interface (/admin). Single shared
# secret, not per-admin accounts - see app/admin_auth.py for why.
ADMIN_PASSWORD=choose-a-strong-password-here

# Optional: a second model tried if the primary fails twice (e.g. a paid model slug).
FALLBACK_MODEL=

# Allowed browser origins for the API. "*" is fine locally; in production set it to
# your frontend URL, e.g. https://your-app.vercel.app (no trailing slash).
CORS_ORIGINS=*
